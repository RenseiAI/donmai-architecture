{
  "profile": "retired_source_recovery_negative_v1",
  "happyVectorSha256": "2b059d10e60a05ed929acbe706d3bf892b6a1fadb3aca4693d4ca0f52f61a7e4",
  "rules": {
    "edits": "Apply JSON-pointer assignments to a deep copy of base; absent final keys are inserted. Never mutate the base or retirement record. Then execute redigest. Wire transforms run last on the canonical selected request or response envelope {receipt,proof}.",
    "request_chain": [
      "Reseal successorRequest omitting only reservationRequestDigest.",
      "Reseal request omitting only reconciliationRequestDigest.",
      "Update receipt.reconciliationRequestDigest and receipt.successorReservationRequestDigest only; execute receipt_proof.",
      "Do not repair semantic scope, IDs, floor, cursor, versions or outcome fields."
    ],
    "receipt_proof": [
      "Reseal receipt omitting only receiptDigest.",
      "Update proof.retirementAnchor.reconciliationReceiptDigest; execute proof_only."
    ],
    "proof_only": [
      "Update proof.reservationRequestDigest from child except if that exact pointer is an intentional edit.",
      "Reseal proof omitting only proofDigest.",
      "Update signedClaimProjection.proof_digest and reservation_request_digest, and copy the full proof retirementAnchor into its snake_case claim projection. Never treat this projection as a signed JWT."
    ],
    "none": "No resealing: encoding or body-boundary mutation only.",
    "hashing": "RFC8785 UTF-8 SHA-256, omitting only the digest member owned by that object, including deliberately unknown fields. All strings/keys here are ASCII; no floating-point numeric inputs.",
    "entrypoints": "Request cases reject at strict request validation before any journal mutation. Receipt/proof cases reject comparison with complete accompanying request/receipt, not just digest validation. exact_replay first commits the unchanged happy request using actual journal Retire/CAS, then submits the redigested mutation. frozen_request_bytes compares against stored canonical bytes before dispatch. HTTP response body is the {receipt,proof} envelope.",
    "behavior": "Materialization and valid digest checks are fixture integrity only. Implementations must exercise actual named boundaries; HTTP size controls use legal whitespace padding so digest failure is not the rejection. Restore-one-predicate controls must make the targeted invalid case pass and then reject again with predicate restored."
  },
